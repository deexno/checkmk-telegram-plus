#!/usr/bin/env python3
"""Minimal Checkmk notification adapter for Checkmk Telegram Plus.

This file intentionally uses only the Python standard library. It runs inside
the Checkmk notification context, builds a bounded JSON payload from NOTIFY_*
variables, sends it to the external app over a Unix domain socket, and falls
back to an append-only local JSONL queue when the app is temporarily down.
"""

from __future__ import annotations

import json
import os
import socket
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

SITE = "<omd_site>"
SOCKET_PATH = "<socket_path>"
FALLBACK_QUEUE_PATH = "<fallback_queue_path>"
TIMEOUT_SECONDS = 2.0
MAX_FIELD_LENGTH = 8192

NOTIFY_FIELDS = (
    "NOTIFY_PARAMETER_1",
    "NOTIFY_HOSTADDRESS",
    "NOTIFY_HOSTNAME",
    "NOTIFY_HOSTGROUPNAMES",
    "NOTIFY_WHAT",
    "NOTIFY_SERVICEDESC",
    "NOTIFY_PREVIOUSSERVICEHARDSHORTSTATE",
    "NOTIFY_SERVICESHORTSTATE",
    "NOTIFY_SERVICEOUTPUT",
    "NOTIFY_PREVIOUSHOSTHARDSHORTSTATE",
    "NOTIFY_HOSTSHORTSTATE",
    "NOTIFY_HOSTOUTPUT",
)


def log(message: str) -> None:
    print(f"checkmk-telegram-plus adapter: {message}", file=sys.stderr)


def clean_field(value: object) -> str:
    text = "" if value is None else str(value)
    text = text.replace("\x00", "").replace("\r\n", "\n").replace("\r", "\n")
    if len(text) > MAX_FIELD_LENGTH:
        return text[: MAX_FIELD_LENGTH - 16] + "...[truncated]"
    return text


def build_payload() -> dict[str, object]:
    notify = {field: clean_field(os.environ.get(field, "")) for field in NOTIFY_FIELDS}
    is_service = notify.get("NOTIFY_WHAT", "").upper() == "SERVICE"
    if is_service:
        description = notify["NOTIFY_SERVICEDESC"]
        from_state = notify["NOTIFY_PREVIOUSSERVICEHARDSHORTSTATE"]
        to_state = notify["NOTIFY_SERVICESHORTSTATE"]
        output = notify["NOTIFY_SERVICEOUTPUT"]
    else:
        description = "HOST STATUS"
        from_state = notify["NOTIFY_PREVIOUSHOSTHARDSHORTSTATE"]
        to_state = notify["NOTIFY_HOSTSHORTSTATE"]
        output = notify["NOTIFY_HOSTOUTPUT"]

    legacy_event = ";".join(
        [
            notify["NOTIFY_PARAMETER_1"],
            notify["NOTIFY_HOSTADDRESS"],
            notify["NOTIFY_HOSTNAME"],
            notify["NOTIFY_HOSTGROUPNAMES"],
            description,
            from_state,
            to_state,
            output,
        ]
    )
    return {
        "schema": "checkmk-telegram-plus.notification.v1",
        "site": SITE,
        "event_id": str(uuid.uuid4()),
        "created": datetime.now(timezone.utc).isoformat(),
        "priority": 0,
        "legacy_event": legacy_event,
        "checkmk": notify,
        "service": is_service,
    }


def send_to_socket(payload: dict[str, object]) -> bool:
    body = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode(
        "utf-8"
    )
    request = (
        b"POST /v1/notifications HTTP/1.1\r\n"
        b"Host: checkmk-telegram-plus\r\n"
        b"Content-Type: application/json\r\n"
        + f"Content-Length: {len(body)}\r\n".encode("ascii")
        + b"Connection: close\r\n\r\n"
        + body
    )
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(TIMEOUT_SECONDS)
        client.connect(SOCKET_PATH)
        client.sendall(request)
        response = client.recv(128)
    return response.startswith(b"HTTP/1.0 2") or response.startswith(b"HTTP/1.1 2")


def append_fallback(payload: dict[str, object]) -> None:
    queue_path = Path(FALLBACK_QUEUE_PATH)
    queue_path.parent.mkdir(parents=True, exist_ok=True)
    line = json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n"
    fd = os.open(queue_path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
    try:
        os.write(fd, line.encode("utf-8"))
    finally:
        os.close(fd)


def main() -> int:
    payload = build_payload()
    try:
        if send_to_socket(payload):
            return 0
        log("external app returned a non-success response; queued fallback event")
    except Exception as exc:
        log(f"external app unavailable; queued fallback event ({exc})")
    try:
        append_fallback(payload)
        return 0
    except Exception as exc:
        log(f"failed to persist fallback notification ({exc})")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

